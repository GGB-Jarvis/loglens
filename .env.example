# OpenAI 兼容端点（OpenAI、DeepSeek、Qwen、vLLM、Ollama 等）
LOGLENS_LLM_BASE_URL=
LOGLENS_LLM_MODEL=
LOGLENS_LLM_API_KEY=
LOGLENS_LLM_TIMEOUT=120
LOGLENS_LLM_MAX_TOKENS=4000
# 部分网关（如 opencode-go）需要会话请求头；Web「模型设置」可自动导入
LOGLENS_LLM_SESSION_ID=

# 运行记录与产物的存储位置（默认：./data）
LOGLENS_DATA_DIR=data

# 应用运行日志（默认：<LOGLENS_DATA_DIR>/logs/loglens.log，自动轮转）
LOGLENS_LOG_LEVEL=INFO
# LOGLENS_LOG_DIR=data/logs
# LOGLENS_LOG_MAX_BYTES=10485760
# LOGLENS_LOG_BACKUPS=5
# LOGLENS_LOG_DISABLE=0

# Next.js 前端（npm run dev）
# /api/* 会被反代到该地址；默认 http://127.0.0.1:8000
# LOGLENS_API_URL=http://127.0.0.1:8000
